###############################################################################
### REQUIRED ENVIRONMENT VARIABLES - SENSITIVE INFORMATION                  ###
### DO NOT STORE RAW SECRETS HERE IN PLAINTEXT IF AVOIDABLE                ###
### DO NOT UPLOAD OR SHARE THIS FILE UNDER ANY CIRCUMSTANCES               ###
###############################################################################

# Ethereum private key or 1Password reference (e.g. op://vault/item/field)
CRE_ETH_PRIVATE_KEY=your_private_key_here

# Default target used when --target flag is not specified
CRE_TARGET=staging-settings

# Etherscan API key (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key_here


###############################################################################
# CRE CONFIDENTIAL WORKFLOW — PRIVATE POLICY PARAMETERS                      #
# They stay inside the TEE.                                                   #
###############################################################################

# Private key for the CRE agent wallet that signs and submits transactions on XDC.
# Referenced in secrets.yaml as: CRE_TRANSACTION_PRIVATE_KEY
CRE_TRANSACTION_PRIVATE_KEY=your_private_key_here


###############################################################################
# HELPER SCRIPTS                                                              #
###############################################################################

# HTTP trigger URL from: cre workflow deploy --target staging-settings (workflow-xdc)
TRIGGER_URL=http://localhost:2000/trigger...
