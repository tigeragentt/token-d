# ─────────────────────────────────────────────
# Frontend (Vite) environment variables
# Copy to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────

# HTTP trigger URL for workflow-xdc (from: cre workflow deploy --target staging-settings).
# Pre-fills the "CRE Write Trigger" input on the CRE page so you don't have to paste it each time.
VITE_CRE_TRIGGER_URL=https://cre.chain.link/trigger/...

# Local CRE simulation proxy target (used by Vite dev server to bypass CORS).
# Set this to the base URL of your local cre workflow simulate HTTP server.
# The frontend will POST to /cre-proxy, which Vite forwards here.
CRE_PROXY_TARGET=http://localhost:2000/trigger
